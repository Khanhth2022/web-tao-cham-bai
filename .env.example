# Server
PORT=3001
# Nơi lưu users.json / classes.json / assignments.json.
# Bỏ trống thì mặc định là ./data (chạy local không cần cấu hình).
# Trên host có ổ đĩa gắn ngoài thì trỏ vào đó, ví dụ: /var/data
DATA_DIR=

# Tài khoản gia sư / quản trị viên được tạo lần đầu khi chưa có data/users.json
ADMIN_EMAIL=admin@lopso.vn
ADMIN_PASSWORD=thay-bang-mat-khau-it-nhat-12-ky-tu

# DeepSeek Vision (server-side only; never expose this in React/Vite)
# OpenAI-compatible API endpoint
DEEPSEEK_BASE_URL=https://api.xompet.io.vn/v1
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# Supabase (optional for the next data/auth wiring step)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Browser-safe Supabase public values (used by Vite only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
